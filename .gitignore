/target

# Planner and translator output.
/output
/output.sas
/output.sas.reference
sas_plan
/*.sas
*.out

# Profiling output.
perf.*
flamegraph.svg
profile.json.gz
proj.json

# Environments and editor state.
.devenv*
.direnv
.venv/
.vscode
__pycache__/
/.harper-dictionary.txt

# Local research material kept next to the checkout: notes, reviews,
# rendered papers, scratch scripts and benchmark copies. Only the repository
# root collects them, so only the root ignores them; files anywhere else are
# project files and show up in `git status`.
/*.md
!/README.md
!/PUBLISHING.md
!/ARCHITECTURE.md
!/CONTRIBUTING.md
!/CHANGELOG.md
/*.py
/*.pdf
/*.html
/*.zip
/*.txt
/*.log
/.codex*
/.verify/
/cpp/
/dominik/
/experiments/
/ipc2023
/ipc2026
/lab-reports/
/numeric-fd
/others
/pddl/
/scorpion/
/scripts/
/test_outputs/

# The project website, served by GitHub Pages from `docs/`: the hand-written
# pages, stylesheet, logos and the marker that serves them as-is.
/docs/*
!/docs/*.html
!/docs/*.css
!/docs/*.svg
!/docs/.nojekyll

# The Python extension module a local build places into the package.
planforge-py/python/planforge/planforge.abi3.so
